# Disable directory indexing
Options -Indexes

# Standard directory index
DirectoryIndex index.html index.php

# Protect source and config files from direct static access
<FilesMatch "^(server|app|index)\.js$|package\.json|\.env|\.git">
  Order allow,deny
  Deny from all
</FilesMatch>

# Phusion Passenger configuration (Hostinger Cloud / Web Hosting)
<IfModule mod_passenger.c>
  PassengerAppType node
  PassengerStartupFile server.js
</IfModule>
